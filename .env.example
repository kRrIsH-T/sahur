# Copy this file to .env and fill in the values. .env is never committed.

# Gnani speech APIs (Prisma STT + Timbre TTS). Create a key at https://app.gnani.ai/voice
GNANI_API_KEY=your-gnani-api-key-here

# System 2, asked when System 1 is unsure and for questions and follow-ups. Default: the Codex CLI if it is
# installed (uses your ChatGPT sign-in; about 8-10 s per answer), else Gemini or any OpenAI-compatible API
# below. The Claude Code CLI answers in about 4-6 s (uses your Claude sign-in: claude auth login).
# LLM_PROVIDER=codex          codex, claude or openai
# CODEX_MODEL=gpt-6-luna
# CODEX_EFFORT=low
# CODEX_FAST=0
# CODEX_PATH=                 if codex is not on PATH
# CLAUDE_MODEL=haiku          the fastest; sonnet if answers need more care
# CLAUDE_EFFORT=low
# CLAUDE_PATH=                if claude is not on PATH

# Gemini (LLM_PROVIDER=openai). Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-3.5-flash-lite
# Requests per minute to stay under (Gemini free tier is about 15). Remove for a paid key.
LLM_RPM=14

# Or any other OpenAI-compatible chat API instead of Gemini, e.g. a self-hosted Evon v3.3 behind vLLM:
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=your-llm-api-key-here
# LLM_MODEL=evon-v3.3

# Reply fallback: hi-IN, en-IN, kn-IN, ta-IN, te-IN, mr-IN, ml-IN, bn-IN, gu-IN, pa-IN
# Native script/model language detection takes priority when confident.
USER_LANGUAGE=hi-IN

# Optional overrides
# DECIDER=system1           system1 (default: own model, System 2 when unsure), fast (own model only), llm, laya
# PREFERENCES_PATH=preferences.json   what Sahur learns about you (media apps, names, habits)
# STT_MODEL=prisma-v3.0
# STT_LANGUAGES=hi-IN,en-IN,kn-IN,ta-IN
# STT_FORMAT=transliterate  (Latin script for all languages; "codemix" keeps native scripts)
# TTS_MODEL=timbre-v3.0
# TTS_VOICE=Shivani
# CONFIDENCE_THRESHOLD=0.55
# HOTKEY=ctrl+space
# ENABLE_WAKE_WORD=0       optional offline wake detector; requires a validated wake.npz
# LAYA_MODEL=multilingual
